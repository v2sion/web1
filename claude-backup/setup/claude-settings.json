{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,

    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr /*)",
      "Bash(sudo rm *)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(chmod -R 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)"
    ],

    "ask": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(npm publish*)"
    ],

    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git branch*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(pnpm run *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(node --version)"
    ]
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false
  },

  "cleanupPeriodDays": 3650,
  "autoUploadSessions": true,
  "fileCheckpointingEnabled": true,

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guards/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guards/bash-audit.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/guards/bash-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guards/unpushed-check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
